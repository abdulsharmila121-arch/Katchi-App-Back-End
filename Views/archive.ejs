</html><!DOCTYPE html>
<html lang="ta">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>காப்பகப்படுத்தப்பட்ட கோப்புகள் (Archive)</title>
    
    <!-- Google Fonts & FontAwesome Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary-blue: #0f172a;
            --accent-orange: #ea580c;
            --hover-orange: #c2410c;
            --light-bg: #f8fafc;
            --card-border: #e2e8f0;
            --text-dark: #1e293b;
            --text-muted: #64748b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
            padding: 30px 20px;
            min-height: 100vh;
            color: var(--text-dark);
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
        }

        /* Header Navigation */
        .top-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            background: var(--primary-blue);
            color: white;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
        }

        .back-btn:hover {
            background: #1e293b;
            transform: translateY(-2px);
        }

        /* Main Card */
        .card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            padding: 28px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            border: 1px solid var(--card-border);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #f1f5f9;
            padding-bottom: 18px;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .card-title {
            font-size: 20px;
            color: var(--primary-blue);
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
        }

        .count-badge {
            background: #ffedd5;
            color: var(--accent-orange);
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        /* Actions Bar: Search, Filters & Export Buttons */
        .controls-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .search-box {
            position: relative;
            flex: 1;
            min-width: 260px;
        }

        .search-box i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
        }

        .search-box input {
            width: 100%;
            padding: 11px 14px 11px 40px;
            border: 1.5px solid #cbd5e1;
            border-radius: 10px;
            font-size: 14px;
            outline: none;
            transition: all 0.2s;
        }

        .search-box input:focus {
            border-color: var(--accent-orange);
            box-shadow: 0 0 0 3px rgba(234, 88, 12, 0.15);
        }

        .action-btns {
            display: flex;
            gap: 10px;
        }

        .btn-export {
            background: #ffffff;
            border: 1.5px solid #cbd5e1;
            color: var(--text-dark);
            padding: 10px 16px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
        }

        .btn-export:hover {
            background: #f8fafc;
            border-color: var(--text-muted);
        }

        /* Table Styling */
        .table-container {
            overflow-x: auto;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            background: white;
        }

        th {
            background: linear-gradient(135deg, var(--accent-orange) 0%, var(--hover-orange) 100%);
            color: white;
            padding: 16px;
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        td {
            padding: 16px;
            border-bottom: 1px solid #f1f5f9;
            font-size: 14px;
            color: var(--text-dark);
        }

        tbody tr:hover {
            background-color: #fff7ed;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        /* Status Badge */
        .status-archived {
            background: #dcfce7;
            color: #15803d;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .empty-state {
            text-align: center;
            padding: 40px !important;
            color: var(--text-muted);
        }

        .empty-state i {
            font-size: 40px;
            margin-bottom: 10px;
            color: #cbd5e1;
            display: block;
        }

        /* Footer Pagination */
        .table-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 20px;
            font-size: 13px;
            color: var(--text-muted);
            flex-wrap: wrap;
            gap: 10px;
        }

        .pagination {
            display: flex;
            gap: 6px;
        }

        .page-btn {
            border: 1px solid #cbd5e1;
            background: white;
            padding: 6px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
            transition: all 0.2s;
        }

        .page-btn.active, .page-btn:hover {
            background: var(--accent-orange);
            color: white;
            border-color: var(--accent-orange);
        }

        @media (max-width: 768px) {
            .controls-bar {
                flex-direction: column;
                align-items: stretch;
            }
            .action-btns {
                justify-content: flex-end;
            }
        }
    </style>
</head>
<body>

<div class="container">

    <!-- Top Back Button -->
    <div class="top-nav">
        <a href="/" class="back-btn"><i class="fa-solid fa-house"></i> முதன்மைப் பக்கத்திற்குச் செல்</a>
    </div>

    <!-- Main Card Section -->
    <div class="card">
        
        <div class="card-header">
            <h2 class="card-title">
                <i class="fa-solid fa-box-archive" style="color: var(--accent-orange);"></i> 
                காப்பகப்படுத்தப்பட்ட வரலாற்று மனுக்கள் (Archived Complaints)
            </h2>
            <span class="count-badge"><%= archivedComplaints ? archivedComplaints.length : 0 %> கோப்புகள்</span>
        </div>

        <!-- 🆕 Controls Bar: Search & Export Options -->
        <div class="controls-bar">
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="archiveSearch" onkeyup="filterArchiveTable()" placeholder="மனு எண், பெயர் அல்லது வகை கொண்டு தேடவும்...">
            </div>
            
            <div class="action-btns">
                <button class="btn-export" onclick="window.print()"><i class="fa-solid fa-print"></i> அச்சிடு</button>
                <button class="btn-export" onclick="alert('Excel பதிவிறக்கம் செய்யப்படுகிறது...')"><i class="fa-solid fa-file-excel" style="color: #16a34a;"></i> Excel</button>
            </div>
        </div>

        <!-- Table Data Section -->
        <div class="table-container">
            <table id="archiveTable">
                <thead>
                    <tr>
                        <th><i class="fa-solid fa-hashtag"></i> மனு எண்</th>
                        <th><i class="fa-solid fa-user"></i> மனுதாரர் பெயர்</th>
                        <th><i class="fa-solid fa-layer-group"></i> வகை</th>
                        <th><i class="fa-solid fa-circle-check"></i> நிலை</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(!archivedComplaints || archivedComplaints.length === 0) { %>
                        <tr>
                            <td colspan="4" class="empty-state">
                                <i class="fa-solid fa-folder-open"></i>
                                காப்பகத்தில் கோப்புகள் எதுவும் இல்லை.
                            </td>
                        </tr>
                    <% } else { %>
                        <% archivedComplaints.forEach(item => { %>
                            <tr>
                                <td><strong><%= item.grievanceId %></strong></td>
                                <td><%= item.citizenName %></td>
                                <td><%= item.grievanceCategory %></td>
                                <td>
                                    <span class="status-archived">
                                        <i class="fa-solid fa-circle-check"></i> Archived (Completed)
                                    </span>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- 🆕 Footer Pagination & Meta -->
        <div class="table-footer">
            <span>காப்பகப்படுத்தப்பட்ட கோப்புகளின் பட்டியல்</span>
            <div class="pagination">
                <button class="page-btn active">1</button>
                <button class="page-btn">2</button>
                <button class="page-btn">அடுத்தது ➡️</button>
            </div>
        </div>

    </div>

</div>

<!-- Interactive Search Script -->
<script>
    function filterArchiveTable() {
        const input = document.getElementById("archiveSearch");
        const filter = input.value.toLowerCase();
        const table = document.getElementById("archiveTable");
        const tr = table.getElementsByTagName("tr");

        for (let i = 1; i < tr.length; i++) {
            let rowText = tr[i].textContent || tr[i].innerText;
            if (rowText.toLowerCase().indexOf(filter) > -1) {
                tr[i].style.display = "";
            } else {
                tr[i].style.display = "none";
            }
        }
    }
</script>

</body>
</html>