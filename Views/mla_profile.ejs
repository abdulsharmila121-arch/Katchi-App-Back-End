<!DOCTYPE html>
<html lang="ta">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>சுயவிவர நிர்வாகம்</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 min-h-screen py-8 px-4 font-sans">

    <div class="max-w-4xl mx-auto bg-white rounded-2xl shadow-xl overflow-hidden">
        
        <!-- Header Banner -->
        <div class="bg-gradient-to-r from-blue-900 to-indigo-800 text-white p-6 sm:p-8 relative">
            <a href="/dashboard" class="inline-flex items-center text-sm bg-white/10 hover:bg-white/20 text-white px-4 py-2 rounded-lg transition duration-200 backdrop-blur-sm mb-4">
                <i class="fas fa-arrow-left mr-2"></i> Dashboard
            </a>
            <div class="text-center">
                <h1 class="text-2xl sm:text-3xl font-extrabold tracking-wide">
                    <%= (typeof currentRole !== 'undefined' && currentRole === 'Poruppalar') ? 'பொறுப்பாளர் சுயவிவர நிர்வாகம்' : 'MLA சுயவிவர நிர்வாகம்' %>
                </h1>
                <p class="text-blue-100 text-sm mt-2 opacity-90">
                    <%= (typeof currentRole !== 'undefined' && currentRole === 'Poruppalar') ? 'பொறுப்பாளர் தனிப்பட்ட விவரங்கள் மற்றும் தகவல்களைப் புதுப்பிக்கவும்' : 'தனிப்பட்ட விவரங்கள் மற்றும் தகவல்களைப் புதுப்பிக்கவும்' %>
                </p>
            </div>
        </div>

        <!-- Profile Form -->
        <form id="profileForm" enctype="multipart/form-data" class="p-6 sm:p-10 space-y-8">
            
            <!-- Profile Image Section -->
            <div class="flex flex-col items-center justify-center -mt-16 sm:-mt-20">
                <div class="relative group">
                    <img id="imagePreview" 
                         src="<%= mla.profileImage || 'https://via.placeholder.com/150' %>" 
                         alt="Profile Picture" 
                         class="w-32 h-32 sm:w-36 sm:h-36 rounded-full object-cover border-4 border-white shadow-lg group-hover:opacity-90 transition">
                    
                    <label for="profileImage" class="absolute bottom-1 right-1 bg-indigo-600 hover:bg-indigo-700 text-white p-3 rounded-full cursor-pointer shadow-md transition transform hover:scale-105">
                        <i class="fas fa-camera text-sm"></i>
                        <input type="file" id="profileImage" name="profileImage" accept="image/*" class="hidden" onchange="previewFile()">
                    </label>
                </div>
                <span class="text-xs text-gray-500 mt-2">புகைப்படம் மாற்ற மேலே உள்ள கேமரா ஐகானைக் கிளிக் செய்யவும்</span>
            </div>

            <!-- Form Inputs Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                
                <!-- Name -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">பெயர் (Name):</label>
                    <input type="text" name="name" value="<%= mla.name || '' %>" required
                           class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition bg-gray-50 focus:bg-white">
                </div>

                <!-- Party -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">அரசியல் கட்சி (Party):</label>
                    <input type="text" name="party" value="<%= mla.party || '' %>"
                           class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition bg-gray-50 focus:bg-white">
                </div>

                <!-- Designation -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">பதவி (Designation):</label>
                    <input type="text" name="designation" value="<%= mla.designation || '' %>"
                           class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition bg-gray-50 focus:bg-white">
                </div>

                <!-- Constituency -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">தொகுதி (Constituency):</label>
                    <input type="text" name="constituency" value="<%= mla.constituency || '' %>"
                           class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition bg-gray-50 focus:bg-white">
                </div>

                <!-- Mobile -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">அலைபேசி எண் (Mobile):</label>
                    <input type="tel" name="mobile" value="<%= mla.mobile || '' %>"
                           class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition bg-gray-50 focus:bg-white">
                </div>

                <!-- Email -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">மின்னஞ்சல் (Email):</label>
                    <input type="email" name="email" value="<%= mla.email || '' %>"
                           class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition bg-gray-50 focus:bg-white">
                </div>

                <!-- Office Hours -->
                <div class="sm:col-span-2">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">அலுவலக வேலை நேரம் (Office Hours):</label>
                    <input type="text" name="officeHours" value="<%= mla.officeHours || '' %>" placeholder="எ.கா: காலை 09:00 - மாலை 05:00"
                           class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition bg-gray-50 focus:bg-white">
                </div>

                <!-- Address -->
                <div class="sm:col-span-2">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">அலுவலக முகவரி (Address):</label>
                    <textarea name="address" rows="3" 
                              class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition bg-gray-50 focus:bg-white"><%= mla.address || '' %></textarea>
                </div>

            </div>

            <!-- Submit Button -->
            <div class="pt-4 text-center">
                <button type="submit" id="submitBtn" 
                        class="w-full sm:w-auto px-10 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-lg hover:shadow-indigo-500/30 transition duration-200 transform hover:-translate-y-0.5">
                    சுயவிவரத்தைப் புதுப்பி (Update Profile)
                </button>
            </div>

        </form>
    </div>

    <!-- Script for Image Preview & AJAX Submit -->
    <script>
        function previewFile() {
            const preview = document.getElementById('imagePreview');
            const file = document.getElementById('profileImage').files[0];
            const reader = new FileReader();

            reader.onloadend = function () {
                preview.src = reader.result;
            }

            if (file) {
                reader.readAsDataURL(file);
            }
        }

        document.getElementById('profileForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerText = "புதுப்பிக்கப்படுகிறது...";

            const formData = new FormData(this);

            try {
                const response = await fetch('/mla/profile/update', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                if (result.success) {
                    alert('சுயவிவரம் வெற்றிகரமாக புதுப்பிக்கப்பட்டது!');
                    if (result.profileImage) {
                        document.getElementById('imagePreview').src = result.profileImage;
                    }
                } else {
                    alert('பிழை: ' + result.message);
                }
            } catch (err) {
                console.error(err);
                alert('Profile update செய்வதில் பிழை ஏற்பட்டது.');
            } finally {
                btn.disabled = false;
                btn.innerText = "சுயவிவரத்தைப் புதுப்பி (Update Profile)";
            }
        });
    </script>
</body>
</html>