<!DOCTYPE html>
<html lang="ta">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MLA Profile Settings</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Tamil:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        * { 
            box-sizing: border-box; 
            font-family: 'Noto Sans Tamil', sans-serif; 
        }
        body { 
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364); 
            min-height: 100vh; 
            margin: 0; 
            padding: 40px 20px; 
            color: #333; 
        }
        
        .profile-card { 
            max-width: 750px; 
            margin: 0 auto; 
            background: #ffffff; 
            border-radius: 16px; 
            box-shadow: 0 15px 35px rgba(0,0,0,0.25); 
            overflow: hidden; 
        }

        /* Card Header with Dashboard Button */
        .card-header { 
            background: linear-gradient(45deg, #0b3c5d, #1d6fa5); 
            color: white; 
            padding: 25px; 
            position: relative;
            text-align: center; 
        }
        .btn-dashboard-top {
            position: absolute;
            left: 20px;
            top: 25px;
            background: rgba(255, 255, 255, 0.15);
            color: white;
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            backdrop-filter: blur(5px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            transition: 0.3s;
        }
        .btn-dashboard-top:hover {
            background: white;
            color: #0b3c5d;
        }

        .card-header h2 { 
            margin: 0; 
            font-size: 24px; 
            letter-spacing: 0.5px; 
        }
        .card-header p { 
            margin: 5px 0 0; 
            opacity: 0.8; 
            font-size: 13px; 
        }
        
        .card-body { 
            padding: 30px; 
        }
        
        /* Fixed Image Circle Box */
        .image-upload-wrapper { 
            text-align: center; 
            margin-bottom: 25px; 
        }
        .profile-img-container { 
            position: relative; 
            width: 130px; 
            height: 130px; 
            margin: 0 auto 12px; 
            border-radius: 50%; 
            overflow: hidden; 
            border: 4px solid #0b3c5d; 
            box-shadow: 0 4px 10px rgba(0,0,0,0.15); 
            background-color: #f1f5f9;
        }
        #imgPreview { 
            width: 100% !important; 
            height: 100% !important; 
            object-fit: cover !important; 
            display: block;
        }

        .upload-btn-label { 
            display: inline-block; 
            background-color: #f0f4f8; 
            color: #0b3c5d; 
            padding: 8px 18px; 
            border-radius: 20px; 
            font-size: 13px; 
            font-weight: 600; 
            cursor: pointer; 
            border: 1px solid #cbd5e1; 
            transition: 0.3s; 
        }
        .upload-btn-label:hover { 
            background-color: #0b3c5d; 
            color: white; 
        }
        #profileImage { 
            display: none; 
        }

        /* Responsive Form Layout */
        .form-grid { 
            display: grid; 
            grid-template-columns: 1fr 1fr; 
            gap: 15px; 
        }
        .full-width { 
            grid-column: span 2; 
        }
        
        .form-group { 
            margin-bottom: 5px; 
        }
        .form-group label { 
            display: block; 
            font-weight: 600; 
            font-size: 13.5px; 
            margin-bottom: 6px; 
            color: #1e293b; 
        }
        .form-group input, .form-group textarea { 
            width: 100%; 
            padding: 11px 14px; 
            border: 1.5px solid #cbd5e1; 
            border-radius: 8px; 
            font-size: 14px; 
            transition: 0.3s; 
            background: #f8fafc; 
        }
        .form-group input:focus, .form-group textarea:focus { 
            border-color: #0b3c5d; 
            background: #fff; 
            outline: none; 
            box-shadow: 0 0 0 3px rgba(11, 60, 93, 0.15); 
        }
        
        /* Action Buttons Grid */
        .button-group {
            display: flex;
            gap: 12px;
            margin-top: 20px;
        }
        .btn-submit { 
            flex: 2;
            background: linear-gradient(45deg, #0b3c5d, #1d6fa5); 
            color: white; 
            border: none; 
            padding: 14px; 
            font-size: 16px; 
            font-weight: 700; 
            border-radius: 8px; 
            cursor: pointer; 
            box-shadow: 0 4px 12px rgba(11, 60, 93, 0.3); 
            transition: 0.3s; 
        }
        .btn-submit:hover { 
            transform: translateY(-2px); 
            box-shadow: 0 6px 15px rgba(11, 60, 93, 0.4); 
        }
        .btn-dashboard-bottom {
            flex: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #e2e8f0;
            color: #334155;
            text-decoration: none;
            padding: 14px;
            font-size: 15px;
            font-weight: 700;
            border-radius: 8px;
            transition: 0.3s;
            text-align: center;
        }
        .btn-dashboard-bottom:hover {
            background: #cbd5e1;
            color: #0f172a;
        }

        @media (max-width: 600px) { 
            .form-grid { grid-template-columns: 1fr; } 
            .full-width { grid-column: span 1; } 
            .card-header { padding-top: 60px; }
            .btn-dashboard-top { top: 15px; left: 50%; transform: translateX(-50%); }
            .button-group { flex-direction: column; }
        }
    </style>
</head>
<body>

<div class="profile-card">
    <div class="card-header">
        <!-- Header Top Button -->
        <a href="/dashboard" class="btn-dashboard-top">← Dashboard</a>
        <h2>MLA சுயவிவர நிர்வாகம்</h2>
        <p>தனிப்பட்ட விவரங்கள் மற்றும் தகவல்களைப் புதுப்பிக்கவும்</p>
    </div>

    <div class="card-body">
        <form id="profileForm" enctype="multipart/form-data">
            
            <!-- Image Upload & Live Preview Section -->
            <div class="image-upload-wrapper">
                <div class="profile-img-container">
                    <img id="imgPreview" 
                         src="<%= (mla && mla.profileImage && mla.profileImage !== '') ? mla.profileImage : 'https://cdn-icons-png.flaticon.com/512/3135/3135715.png' %>" 
                         onerror="this.onerror=null; this.src='https://cdn-icons-png.flaticon.com/512/3135/3135715.png';" 
                         alt="MLA Profile Picture">
                </div>
                <label for="profileImage" class="upload-btn-label">📷 புகைப்படம் மாற்றுக</label>
                <input type="file" id="profileImage" name="profileImage" accept="image/*">
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label>பெயர் (Name):</label>
                    <input type="text" id="name" name="name" value="<%= mla ? mla.name : '' %>" required>
                </div>

                <div class="form-group">
                    <label>அரசியல் கட்சி (Party):</label>
                    <input type="text" id="party" name="party" value="<%= (mla && mla.party) ? mla.party : '' %>" placeholder="கட்சி பெயர்">
                </div>

                <div class="form-group">
                    <label>பதவி (Designation):</label>
                    <input type="text" id="designation" name="designation" value="<%= (mla && mla.designation) ? mla.designation : 'சட்டமன்ற உறுப்பினர்' %>">
                </div>

                <div class="form-group">
                    <label>தொகுதி (Constituency):</label>
                    <input type="text" id="constituency" name="constituency" value="<%= mla ? mla.constituency : '' %>" required>
                </div>

                <div class="form-group">
                    <label>அலைபேசி எண் (Mobile):</label>
                    <input type="tel" id="mobile" name="mobile" value="<%= mla ? mla.mobile : '' %>" required>
                </div>

                <div class="form-group">
                    <label>மின்னஞ்சல் (Email):</label>
                    <input type="email" id="email" name="email" value="<%= mla ? mla.email : '' %>">
                </div>

                <div class="form-group full-width">
                    <label>அலுவலக வேலை நேரம் (Office Hours):</label>
                    <input type="text" id="officeHours" name="officeHours" value="<%= (mla && mla.officeHours) ? mla.officeHours : '' %>" placeholder="எ.கா: காலை 09:00 - மாலை 05:00">
                </div>

                <div class="form-group full-width">
                    <label>அலுவலக முகவரி (Address):</label>
                    <textarea id="address" name="address" rows="3"><%= mla ? mla.address : '' %></textarea>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="button-group">
                <button type="submit" class="btn-submit">Profile Update செய்</button>
                <a href="/dashboard" class="btn-dashboard-bottom">Dashboard</a>
            </div>
        </form>
    </div>
</div>

<script>
// Image Selection - Local Live Preview
document.getElementById('profileImage').addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (file) {
        const reader = new FileReader();
        reader.onload = function(event) {
            document.getElementById('imgPreview').src = event.target.result;
        };
        reader.readAsDataURL(file);
    }
});

// Form Submit Handler
document.getElementById('profileForm').addEventListener('submit', async function(e) {
    e.preventDefault();

    const formData = new FormData(this);

    try {
        const response = await fetch('/mla/profile/update', {
            method: 'POST',
            body: formData
        });

        const result = await response.json();
        alert(result.message);

        if (result.success && result.profileImage) {
            document.getElementById('imgPreview').src = result.profileImage + '?t=' + new Date().getTime();
        }
    } catch (error) {
        console.error("Update Error:", error);
        alert("Update செய்வதில் பிழை ஏற்பட்டது!");
    }
});
</script>

</body>
</html>