<!DOCTYPE html>
<html lang="ta">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>மனு முழு விவரங்கள்</title>
    
    <!-- Google Fonts & FontAwesome Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary-blue: #0f172a;
            --accent-blue: #2563eb;
            --hover-blue: #1d4ed8;
            --light-bg: #f8fafc;
            --card-border: #e2e8f0;
            --text-dark: #1e293b;
            --text-muted: #64748b;
        }

        * { 
            box-sizing: border-box; 
            margin: 0;
            padding: 0;
            font-family: 'Poppins', sans-serif; 
        }

        body { 
            background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
            padding: 30px 20px; 
            min-height: 100vh;
            color: var(--text-dark);
        }

        .container { 
            max-width: 1100px; 
            margin: 0 auto; 
        }

        /* Top Bar & Back Button */
        .top-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            background: var(--primary-blue);
            color: white;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
        }

        .back-btn:hover {
            background: #1e293b;
            transform: translateY(-2px);
        }

        /* Main Grid Layout */
        .page-grid {
            display: grid;
            grid-template-columns: 1fr 360px;
            gap: 25px;
        }

        /* Cards Base Style */
        .card { 
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            padding: 25px; 
            border-radius: 16px; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.05); 
            border: 1px solid var(--card-border);
            margin-bottom: 25px;
        }

        /* 🔍 Grievance Search Box */
        .search-card {
            background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
        }

        .search-card h3 {
            margin-bottom: 12px;
            color: var(--primary-blue);
            font-size: 18px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .search-form {
            display: flex;
            gap: 10px;
        }

        .search-form input {
            flex: 1;
            padding: 12px 16px;
            border: 1.5px solid #cbd5e1;
            border-radius: 10px;
            font-size: 14px;
            outline: none;
            transition: all 0.2s;
        }

        .search-form input:focus {
            border-color: var(--accent-blue);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        }

        .search-form button {
            background: var(--accent-blue);
            color: white;
            border: none;
            padding: 12px 22px;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .search-form button:hover {
            background: var(--hover-blue);
        }

        /* Grievance Details Section */
        .card-header { 
            border-bottom: 2px solid #f1f5f9; 
            padding-bottom: 15px; 
            margin-bottom: 20px; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
        }

        .card-title { 
            font-size: 18px; 
            color: var(--primary-blue); 
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .details-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); 
            gap: 15px; 
        }

        .detail-item { 
            background: #f8fafc; 
            padding: 16px; 
            border-radius: 12px; 
            border-left: 4px solid var(--accent-blue);
            border-top: 1px solid #f1f5f9;
            border-right: 1px solid #f1f5f9;
            border-bottom: 1px solid #f1f5f9;
        }

        .detail-item label { 
            font-size: 11px; 
            color: var(--text-muted); 
            font-weight: 700; 
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: block; 
        }

        .detail-item p { 
            margin: 6px 0 0 0; 
            font-size: 15px; 
            font-weight: 600; 
            color: var(--text-dark); 
        }

        .status-badge { 
            padding: 6px 14px; 
            border-radius: 30px; 
            font-weight: 700; 
            font-size: 13px; 
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .status-pending { background: #fef3c7; color: #d97706; }
        .status-completed { background: #dcfce7; color: #15803d; }
        .status-progress { background: #dbeafe; color: #1e40af; }

        .desc-box { 
            margin-top: 20px; 
            background: #f8fafc; 
            padding: 18px; 
            border-radius: 12px; 
            border: 1px solid #e2e8f0; 
        }

        /* Feedback Form */
        .feedback-form label { 
            display: block; 
            font-weight: 600; 
            margin-top: 15px; 
            font-size: 13px; 
            color: var(--text-dark);
        }

        .feedback-form select, .feedback-form textarea {
            width: 100%; 
            padding: 12px; 
            margin-top: 6px; 
            border: 1.5px solid #cbd5e1; 
            border-radius: 10px; 
            outline: none;
            font-size: 14px;
            transition: all 0.2s;
        }

        .feedback-form select:focus, .feedback-form textarea:focus {
            border-color: var(--accent-blue);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        }

        .submit-btn {
            background: #16a34a; 
            color: white; 
            border: none; 
            padding: 14px; 
            width: 100%;
            margin-top: 18px; 
            border-radius: 10px; 
            font-size: 15px; 
            font-weight: 600; 
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .submit-btn:hover {
            background: #15803d;
        }

        /* 🤖 AI Assistant Card Styles */
        .ai-assistant-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 22px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            border: 1px solid var(--card-border);
            height: fit-content;
        }

        .ai-assistant-card h3 {
            margin: 0 0 4px 0;
            color: var(--primary-blue);
            font-size: 18px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .ai-assistant-card .subtitle {
            font-size: 12px;
            color: var(--text-muted);
            margin-bottom: 16px;
            line-height: 1.4;
        }

        .chat-input-group {
            display: flex;
            gap: 8px;
        }

        .chat-input-group input {
            flex: 1;
            padding: 10px 14px;
            border: 1.5px solid #cbd5e1;
            border-radius: 8px;
            outline: none;
            font-size: 13px;
            transition: border-color 0.2s;
        }

        .chat-input-group input:focus {
            border-color: var(--accent-blue);
        }

        .chat-input-group button {
            background: var(--accent-blue);
            color: white;
            border: none;
            padding: 10px 14px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: background 0.2s;
        }

        .chat-input-group button:hover {
            background: var(--hover-blue);
        }

        .response-box {
            margin-top: 14px;
            padding: 14px;
            border-radius: 10px;
            background: #f8fafc;
            font-size: 13px;
            border-left: 4px solid var(--accent-blue);
            border-top: 1px solid #e2e8f0;
            border-right: 1px solid #e2e8f0;
            border-bottom: 1px solid #e2e8f0;
        }

        /* Responsive Breakpoints */
        @media (max-width: 900px) {
            .page-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

<div class="container">
    
    <div class="top-nav">
        <a href="/" class="back-btn"><i class="fa-solid fa-house"></i> முதன்மைப் பக்கத்திற்குச் செல்</a>
    </div>

    <!-- Main Grid Container -->
    <div class="page-grid">
        
        <!-- LEFT COLUMN: Search & Grievance Details -->
        <div class="left-column">
            
            <!-- 🔍 Grievance ID Search Box -->
            <div class="card search-card">
                <h3><i class="fa-solid fa-magnifying-glass"></i> மனுவின் நிலையை அறிய (Check Status)</h3>
                <form action="/grievance-details" method="GET" class="search-form">
                    <input 
                        type="text" 
                        name="id" 
                        placeholder="உங்கள் மனு எண்ணை உள்ளிடவும் (e.g. GRIEV-2026-0002)" 
                        required
                    >
                    <button type="submit"><i class="fa-solid fa-search"></i> தேடு</button>
                </form>
            </div>

            <!-- Grievance Full Details -->
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title"><i class="fa-solid fa-file-lines"></i> மனுவின் முழு தகவல்கள்</h2>
                    <span id="statusBadge" class="status-badge status-pending"><i class="fa-solid fa-clock"></i> நிலுவையில் உள்ளது</span>
                </div>

                <div class="details-grid">
                    <div class="detail-item">
                        <label>மனு எண் (Grievance ID)</label>
                        <p id="dispGrievanceId">-</p>
                    </div>
                    
                    <div class="detail-item">
                        <label>துறை (Department)</label>
                        <p id="dispDepartment">-</p>
                    </div>
                    <div class="detail-item">
                        <label>பதிவு செய்யப்பட்ட தேதி</label>
                        <p id="dispDate">-</p>
                    </div>
                    <div class="detail-item">
                        <label>மனுதாரர் பெயர்</label>
                        <p id="dispName">-</p>
                    </div>
                </div>

                <div class="desc-box">
                    <label style="font-size: 11px; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">மனுவின் விவரம் (Description):</label>
                    <p id="dispDescription" style="margin-top: 8px; line-height: 1.6; color: #334155;">-</p>
                </div>
            </div>

            <!-- Public Feedback Section -->
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title"><i class="fa-solid fa-star"></i> உங்கள் கருத்து (Public Feedback)</h2>
                </div>
                
                <form class="feedback-form" onsubmit="submitFeedback(event)">
                    <label>சேவை மதிப்பீடு (Rating):</label>
                    <select id="rating" required>
                        <option value="5">⭐⭐⭐⭐⭐ - மிகவும் திருப்தி</option>
                        <option value="4">⭐⭐⭐⭐ - திருப்தி</option>
                        <option value="3">⭐⭐⭐ - பரவாயில்லை</option>
                        <option value="2">⭐⭐ - திருப்தியில்லை</option>
                        <option value="1">⭐ - மிகவும் மோசம்</option>
                    </select>

                    <label>கருத்துக்கள் / பரிந்துரைகள்:</label>
                    <textarea id="feedbackText" rows="4" placeholder="இங்கு உங்கள் கருத்தைப் பதிவிடவும்..." required></textarea>

                    <button type="submit" class="submit-btn"><i class="fa-solid fa-paper-plane"></i> கருத்தை சமர்ப்பி (Submit Feedback)</button>
                </form>
                <div id="feedbackResponse" style="margin-top: 15px; font-weight: 600; text-align: center; font-size: 14px;"></div>
            </div>

        </div>

        <!-- RIGHT COLUMN: AI Assistant -->
        <div class="right-column">
            
            <div class="ai-assistant-card">
                <h3><i class="fa-solid fa-robot" style="color: var(--accent-blue);"></i> AI Assistant</h3>
                <p class="subtitle">உங்கள் மனு நிலையை (Status) எளிதாக அறிய Grievance ID உள்ளிடவும்</p>
                
                <div class="chat-input-group">
                    <input type="text" id="aiGrievanceInput" placeholder="எ.கா: GRIEV-2026-0002" value="GRIEV-2026-0002" />
                    <button type="button" id="aiSendBtn">
                        <span>அனுப்பு</span>
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </div>

                <!-- Result Show Container -->
                <div id="aiResponseContainer" class="response-box" style="display: none;"></div>
            </div>

        </div>

    </div>

</div>

<!-- Logic Scripts -->
<script>
async function sendMessage() {
  const input = document.getElementById('userInput').value;
  const res = await fetch('/api/chat', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ message: input })
  });
  const data = await res.json();
  document.getElementById('chat-messages').innerHTML += `<p><b>You:</b> ${input}</p><p><b>Bot:</b> ${data.reply}</p>`;
}
</script>

<script>
    window.onload = function() {
        const urlParams = new URLSearchParams(window.location.search);
        const grievanceId = urlParams.get('id');

        if (!grievanceId) {
            return;
        }

        fetch(`/api/quick-status/${encodeURIComponent(grievanceId)}`)
            .then(res => res.json())
            .then(data => {
                if (!data.success) {
                    alert('❌ ' + data.message);
                    return;
                }

                const g = data.grievance;

                // Elements-ல் தகவல்களை நிரப்புதல்
                if (document.getElementById('dispGrievanceId')) {
                    document.getElementById('dispGrievanceId').innerText = g.grievanceId || '-';
                }
                if (document.getElementById('dispDepartment')) {
                    document.getElementById('dispDepartment').innerText = g.department || '-';
                }
                if (document.getElementById('dispDate')) {
                    document.getElementById('dispDate').innerText = g.createdAt || '-';
                }
                if (document.getElementById('dispName')) {
                    document.getElementById('dispName').innerText = g.applicantName || '-';
                }
                if (document.getElementById('dispDescription')) {
                    document.getElementById('dispDescription').innerText = g.description || '-';
                }

                // Status Badge Update
                const badge = document.getElementById('statusBadge');
                if (badge) {
                    badge.innerText = g.status || 'Pending';
                    badge.className = 'status-badge ';
                    if (g.status === 'Completed' || g.status === 'Resolved') {
                        badge.classList.add('status-completed');
                        badge.innerHTML = '<i class="fa-solid fa-circle-check"></i> ' + (g.status || 'Resolved');
                    } else if (g.status === 'In_Progress') {
                        badge.classList.add('status-progress');
                        badge.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> In Progress';
                    } else {
                        badge.classList.add('status-pending');
                        badge.innerHTML = '<i class="fa-solid fa-clock"></i> Pending';
                    }
                }
            })
            .catch(err => {
                console.error('Fetch Error:', err);
            });
    };

    function submitFeedback(event) {
        event.preventDefault();
        const urlParams = new URLSearchParams(window.location.search);
        const grievanceId = urlParams.get('id');
        const rating = document.getElementById('rating').value;
        const feedbackText = document.getElementById('feedbackText').value;

        if (!grievanceId) {
            alert('தயவுசெய்து முதலில் மனுவைத் தேடவும்!');
            return;
        }

        fetch('/api/submit-feedback', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ grievanceId, rating, feedbackText })
        })
        .then(res => res.json())
        .then(data => {
            const respDiv = document.getElementById('feedbackResponse');
            if (data.success) {
                respDiv.style.color = '#16a34a';
                respDiv.innerText = '✅ ' + data.message;
                document.getElementById('feedbackText').value = '';
            } else {
                respDiv.style.color = '#dc2626';
                respDiv.innerText = '❌ கருத்துச் சமர்ப்பிப்பதில் தோல்வி!';
            }
        })
        .catch(err => console.error('Feedback Error:', err));
    }
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('aiSendBtn');
    const input = document.getElementById('aiGrievanceInput');
    const resContainer = document.getElementById('aiResponseContainer');

    async function checkStatus() {
      const grievanceId = input.value.trim();
      if (!grievanceId) {
        alert('தயவுசெய்து Grievance ID உள்ளிடவும்!');
        return;
      }

      resContainer.style.display = 'block';
      resContainer.innerHTML = '⏳ <i>தேடப்படுகிறது...</i>';

      try {
        const response = await fetch(`/api/quick-status/${encodeURIComponent(grievanceId)}`);
        const data = await response.json();

        if (data.success) {
          const g = data.grievance;
          resContainer.innerHTML = `
            <div style="color: #1e293b;">
              <p style="margin: 4px 0;"><strong>மனு எண்:</strong> ${g.grievanceId}</p>
              <p style="margin: 4px 0;"><strong>பெயர்:</strong> ${g.applicantName}</p>
              <p style="margin: 4px 0;"><strong>துறை:</strong> ${g.department}</p>
              <p style="margin: 4px 0;"><strong>நிலை:</strong> <b style="color: #2563eb;">${g.status}</b></p>
            </div>
          `;
        } else {
          resContainer.innerHTML = `<span style="color: #dc2626;">❌ ${data.message}</span>`;
        }
      } catch (err) {
        console.error("Fetch error:", err);
        resContainer.innerHTML = `<span style="color: #dc2626;">⚠️ API தொடர்பு கொள்வதில் பிழை ஏற்பட்டது!</span>`;
      }
    }

    // Button Click Event
    btn.addEventListener('click', checkStatus);

    // Enter Key Press Event
    input.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') checkStatus();
    });
  });
</script>

</body>
</html>