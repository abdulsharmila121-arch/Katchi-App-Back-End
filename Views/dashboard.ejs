                                    let diffHours = diffMs / (1000 * 60 * 60);
                                    if (diffHours > 0 && diffHours <= 5) {
                                        urgencyClass = 'deadline-danger'; 
                                    } else if (diffHours > 0 && diffHours <= 24) {
                                        urgencyClass = 'deadline-warning'; 
                                    }
                                }
                            %>
                                <tr class="<%= urgencyClass %>">
                                    <td>
                                        <strong><%= item.grievanceId %></strong><br><%= item.description %><br>
                                        <small style="color: #e65100; font-weight: bold;"><%= item.grievanceCategory %></small>
                                        
                                        <% if (item.certificateIssued) { %>
                                            <div style="margin-top: 8px; background: #f3e8ff; padding: 8px; border-radius: 3px; border: 1px solid #d8b4fe;">
                                                <span style="font-size:11.5px; font-weight:bold; color:#6b21a8;">📜 MLA பாராட்டுச் சான்றிதழ் தயார்!</span><br>
                                                <button type="button" onclick="generateDynamicPDF('<%= item.grievanceId %>', '<%= item.citizenName %>', 'பொறுப்பாளர்', '<%= item.grievanceCategory %>')" class="status-btn" style="background:#6b21a8; color:white; display:inline-block; text-decoration:none; margin-top:4px; padding: 4px 8px; text-align:center; font-size:10.5px; border-radius:3px;">
                                                    📥 Download PDF Certificate
                                                </button>
                                            </div>
                                        <% } %>

                                        <% if (item.appreciation) { %>
                                            <div style="margin-top: 5px; background: #dcfce7; color: #15803d; padding: 5px; border-radius: 3px; font-size: 11.5px; font-weight: bold;">
                                                🏅 MLA குறிப்பு: <%= item.appreciation %>
                                            </div>
                                        <% } %>
                                    </td>
                                    
                                    <td>
                                        <%= item.streetName %><br><br>
                                        
                                        <% if (item.deadline) { %>
                                            <div class="countdown-timer sla-timer" data-deadline="<%= new Date(item.deadline).getTime() %>">⏳ கணக்கிடப்படுகிறது...</div>
                                            
                                            <form action="/submit-delay-justification" method="POST" style="margin-top:6px; display:flex; gap:4px;">
                                                <input type="hidden" name="grievanceId" value="<%= item.grievanceId %>">
                                                <input type="text" name="delayJustification" placeholder="தாமதத்திற்கான காரணம்..." required style="padding:4px; font-size:10.5px; flex:1; border-radius:3px; border:1px solid #a6a6a6;">
                                                <button type="submit" style="background:#d97706; color:white; border:none; padding:4px 8px; font-size:10.5px; border-radius:3px; cursor:pointer; font-weight:bold;">அனுப்பு</button>
                                            </form>
                                        <% } else { %>
                                            <span style="color: #c62828; font-weight: bold;">⚠️ டெட்நிலை இல்லை</span>
