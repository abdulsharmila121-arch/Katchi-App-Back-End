                    <button type="button" style="background: #c62828; color: white; border: none; padding: 10px 15px; border-radius: 3px; cursor: pointer; font-weight: bold; display: flex; align-items: center; gap: 4px; font-size:13px;">
                        🔴 Record Voice
                    </button>

                    <input type="text" name="directiveText" placeholder="அல்லது நேரடி உரையை டைப் செய்யவும்..." style="flex: 2; padding: 10px; border-radius: 3px; border: 1px solid #a6a6a6;">

