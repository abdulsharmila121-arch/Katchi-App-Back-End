                                                <button type="button" onclick="generatePoster('<%= item.grievanceId %>', 'reels')" style="background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366); color: white; border: none; padding: 4px; font-size: 10.5px; border-radius: 3px; cursor: pointer; font-weight: bold;">🎥 Reels Poster (9:16)</button>
