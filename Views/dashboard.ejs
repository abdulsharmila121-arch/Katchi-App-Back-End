                    <span>மனுவின் விவரம் (Description):</span>
                    <select id="voiceLangSelect" style="padding: 2px 5px; border-radius: 3px; font-size: 11px; font-weight: bold; border: 1px solid #a6a6a6;">
                        <option value="ta-IN">தமிழ் (Tamil)</option>
                        <option value="en-US">English / Tanglish</option>
                    </select>
                    <button type="button" id="voiceBtn" onclick="startSpeechToText()" style="background: #2e7d32; color: white; border: none; padding: 4px 8px; border-radius: 3px; cursor: pointer; font-size: 11px; font-weight: bold; display: flex; align-items: center; gap: 4px;">
                        🎙️ வாய்ஸ் டைப்பிங் (AI Voice)
                    </button>
                </label>
                <textarea id="description" name="description" rows="4" placeholder="புகார் விவரங்களை உள்ளிடவும்..." oninput="autoSelectDepartment()"></textarea>
