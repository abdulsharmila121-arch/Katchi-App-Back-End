                        <option value="கழிவுநீர் / கால்வாய் பிரச்சனை">கழிவுநீர் / கால்வாய் பிரச்சனை</option>
                        <option value="மின்சார பிரச்சனை">மின்சார பிரச்சனை</option>
                        <option value="மற்றவை">மற்றவை</option>
                    </select>
