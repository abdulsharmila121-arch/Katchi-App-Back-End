            <div class="card cm-card" id="cmMainTableSection">
                <h2>📋 CM - அனைத்து மாவட்ட மனுக்கள்</h2>
                <table>
                    <thead>
                        <tr>
                            <th>மனு எண்</th>
                            <th>பெயர்</th>
                            <th>மாவட்டம்</th>
                            <th>விவரம்</th>
                            <th>நிலை (Status)</th>
                            <th>செயல்பாடு (Action)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof complaints !== 'undefined' && complaints.length > 0) { %>
                            <% complaints.forEach(function(item) { %>
                                <tr>
                                    <td><strong>#<%= item.grievanceId %></strong></td>
                                    <td><%= item.citizenName %></td>
                                    <td><%= item.district %></td>
                                    <td><%= item.description %></td>
                                    <td><span class="status-badge Pending_Managaram"><%= item.status %></span></td>
                                    <!-- CM Dashboard Table Actions Section -->
                                    <td style="display: flex; gap: 6px; flex-wrap: wrap;">
                                        
                                        <!-- Option 1: CM-லிருந்து Collector-க்கு நேரடியாக Forward செய்யும் Action -->
