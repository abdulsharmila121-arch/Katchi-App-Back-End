                            <span class="dz-hint">(PNG, JPG, MP4)</span>
                        </div>
                        <input type="file" id="complaintMedia" name="complaintMedia" accept="image/*,video/*" hidden onchange="updateFileName(this, 'mediaFileName')">
                    </div>
                    <span id="mediaFileName" class="file-name-compact"></span>
                </div>

                <!-- 2. Complaint Letter -->
                <div class="upload-card-compact">
                    <label class="upload-label-sm">மனு கடிதம் நகல் (Written Complaint Document):</label>
                    <div class="drop-zone-compact" onclick="document.getElementById('complaintLetter').click()">
                        <div class="dz-content">
                            <span class="dz-icon">📄</span>
                            <span class="dz-text">Document-ஐ தேர்ந்தெடுக்கவும்</span>
                            <span class="dz-hint">(PDF, DOC, Images)</span>
                        </div>
                        <input type="file" id="complaintLetter" name="complaintLetter" accept=".pdf,.doc,.docx,image/*" hidden onchange="updateFileName(this, 'letterFileName')">
                    </div>
                    <span id="letterFileName" class="file-name-compact"></span>
                </div>
            </div>

            <button type="submit" class="btn-public-submit" style="margin-top: 10px;">📤 மனுவை சமர்ப்பி (Submit Grievance)</button>
        </form>
    </div>
<% } %>

        <% if (typeof currentRole !== 'undefined' && currentRole === 'MLA' && typeof complaints !== 'undefined') { 
            let mlaComplaints = complaints.filter(c => c.constituency === constituency); 
        %>

            <!-- MLA DESIGN STYLE -->
            <div id="announcementFormSection" class="card mla-card toggle-section">
                <h3>📢 புதிய பொது அறிவிப்பு பதிவிடுதல் (Post New Announcement)</h3>
                <form action="/add-announcement" method="POST" style="display: flex; flex-direction: column; gap: 12px;">
                    <div class="form-group">
                        <label style="font-weight: bold; margin-bottom: 6px;">அறிவிப்பின் விவரம் (Announcement Content):</label>
                        <textarea name="content" placeholder="பொது மக்களுக்கு தெரிவிக்க வேண்டிய முக்கிய அறிவிப்பை இங்கே எழுதவும்..." required style="padding: 10px; border: 1px solid #a6a6a6; border-radius: 3px; font-size: 13.5px; min-height: 90px; resize: vertical;"></textarea>
                    </div>
                    <button type="submit" class="btn-submit" style="background: var(--gov-blue); max-width: 220px;">📤 அறிவிப்பை வெளியிடு</button>
                </form>
            </div>

            <div id="deptOverview" class="card mla-card toggle-section">
                <h3>📊 துறை வாரியான மனுக்கள் நிலவரம்</h3>
                <table>
                    <thead>
                        <tr><th>துறை பெயர் (Department)</th><th>மொத்த மனுக்கள் எண்ணிக்கை</th></tr>
                    </thead>
                    <tbody>
                        <% 
                            let categories = ["Drinking_Water", "Road_Repair", "Street_Light", "Sewage_Drainage", "Electricity"];
                            categories.forEach(cat => {
                                let count = mlaComplaints.filter(c => c.grievanceCategory === cat).length;
                        %>
                            <tr><td><strong><%= cat %></strong></td><td><span style="font-size:15px; color:var(--gov-blue); font-weight:bold;"><%= count %></span></td></tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <div id="wardPendingList" class="card mla-card toggle-section">
                <h3>📍 வார்டு வாரியான நிலுவை மனுக்கள்</h3>
                <table>
                    <thead>
                        <tr><th>வார்டு எண் (Ward No)</th><th>புதிய மனுக்கள் (Pending)</th><th>நடவடிக்கையில் உள்ளவை (In Progress)</th></tr>
                    </thead>
                    <tbody>
                        <% if (typeof wardList !== 'undefined' && wardList[constituency]) { 
                            wardList[constituency].forEach(ward => {
                                let pending = mlaComplaints.filter(c => c.wardZone === ward && c.status.startsWith('Pending')).length;
                                let progress = mlaComplaints.filter(c => c.wardZone === ward && c.status === 'In_Progress').length;
                        %>
                            <tr>
                                <td><strong><%= ward %></strong></td>
                                <td style="color:#d97706; font-weight:bold;"><%= pending %></td>
                                <td style="color:var(--gov-blue); font-weight:bold;"><%= progress %></td>
                            </tr>
                        <% })} %>
                    </tbody>
                </table>
            </div>

            <div id="leaderboard-section" class="mla-dynamic-section card mla-card" style="display: none;">
                <h3 style="margin-top:0;">🏆 துறை செயல்திறன் லீடர்போர்டு (Leaderboard)</h3>
                <table>
                    <thead>
                        <tr>
                            <th>துறை (Department)</th>
                            <th>முடித்தவை</th>
                            <th>வெற்றி விகிதம்</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% 
                        let finalLeaderboard = [];
                        if (typeof leaderboard !== 'undefined') {
                            finalLeaderboard = leaderboard;
                        } else if (typeof complaintsList !== 'undefined') {
                            let depts = ['Water', 'Electricity', 'Roads', 'Sanitation'];
                            finalLeaderboard = depts.map(dept => {
                                let total = complaintsList.filter(c => c.department === dept).length;
                                let resolved = complaintsList.filter(c => c.department === dept && c.status === 'Completed').length;
                                let rate = total > 0 ? Math.round((resolved / total) * 100) : 0;
                                return { department: dept, resolvedCount: resolved, successRate: `${rate}%` };
                            });
                            finalLeaderboard.sort((a, b) => b.resolvedCount - a.resolvedCount);
                        }
                        finalLeaderboard.forEach(dept => { 
                        %>
                            <tr>
                                <td style="font-weight: bold;"><%= dept.department %></td>
                                <td style="color: #2e7d32; font-weight: bold;"><%= dept.resolvedCount %> மனுக்கள்</td>
                                <td><span style="background:#d4edda; color:#155724; padding:3px 8px; border-radius:3px; font-size:11px; font-weight: bold;"><%= dept.successRate %></span></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <div class="card mla-card">
                <h2>📋 தொகுதி குறைதீர்ப்பு முதன்மை அட்டவணை</h2>
                <table>
                    <thead>
                        <tr>
                            <th style="width: 28%;">மனு எண் & விவரம்</th>
                            <th style="width: 17%;">மனுதாரர்</th>
                            <th style="width: 22%;">செயல்பாடு (Forward)</th>
                            <th style="width: 18%;">நிலை / காலக்கெடு</th>
                            <th style="width: 15%;">காப்பகம் (Archive)</th>
                        </tr>   
                    </thead>
                    <tbody>
                        <% if(mlaComplaints.length === 0) { %>
                            <tr><td colspan="5" style="text-align:center; color: #767676;">கோரிக்கைகள் எதுவும் தற்சமயம் இல்லை.</td></tr>
                        <% } else { %>
                            <% mlaComplaints.forEach(function(item) { %>
                                <tr>
                                    <td>
                                        <strong><%= item.grievanceId %></strong><br>
                                        <small style="color: var(--gov-blue); font-weight: bold;"><%= item.grievanceCategory %></small>
                                        
                                        <div class="attachment-buttons" style="margin-top: 8px; display: flex; gap: 6px; flex-wrap: wrap;">
                                            <% if (item.mediaFile) { %>
