                        <% if(poruppalarComplaints.length === 0) { %>
                            <tr><td colspan="4" style="text-align:center;">தற்போது உங்களுக்குப் பணிகள் ஏதுமில்லை.</td></tr>
                        <% } else { %>
                            <% poruppalarComplaints.forEach(function(item) { 
                                let urgencyClass = '';
