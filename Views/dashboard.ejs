                                        <div style="display: flex; flex-direction: column; gap: 40px;">
                                            <div style="position: relative; height: 450px; border-radius: 10px; overflow: hidden; border: 5px solid #ff9800;"><img src="/uploads/<%= item.beforeImage %>" style="width: 100%; height: 100%; object-fit: cover;"></div>
                                            <div style="position: relative; height: 450px; border-radius: 10px; overflow: hidden; border: 5px solid #4caf50;"><img src="/uploads/<%= item.afterImage %>" style="width: 100%; height: 100%; object-fit: cover;"></div>
