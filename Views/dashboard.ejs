                                                <input type="file" name="beforeImage" required style="font-size:11px;">
                                                <label style="font-size:11px; font-weight: bold;">பணிக்கு பின் படம் (After Image):</label>
                                                <input type="file" name="afterImage" required style="font-size:11px;">
                                                <button type="submit" class="status-btn" style="background:#2e7d32; margin-top:4px;">Upload & Complete Work</button>
                                            </form>

