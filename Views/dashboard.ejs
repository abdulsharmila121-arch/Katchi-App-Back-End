                                                <button type="submit" style="background:#d97706; font-size:10px; color:white; border:none; padding:3px 6px; border-radius:3px; font-weight:bold;">Appreciate</button>
                                            </form>

                                            <button type="button" onclick="generateDynamicPDF('<%= item.grievanceId %>', '<%= item.citizenName %>', 'பொறுப்பாளர்', '<%= item.grievanceCategory %>')" style="background:#6b21a8; font-size:10px; color:white; border:none; padding:4px; border-radius:3px; width:100%; margin-top:3px; cursor:pointer; font-weight:bold;">
                                                Dynamic Certificate 📜
                                            </button>
