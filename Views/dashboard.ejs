        <% if (typeof currentRole !== 'undefined' && currentRole === 'MLA' && typeof complaints !== 'undefined') { 
            let mlaComplaints = complaints.filter(c => c.constituency === constituency); 
        %>

            <div id="announcementFormSection" class="card toggle-section">
                <h3 style="color:#1e3c72;">📢 புதிய பொது அறிவிப்பு பதிவிடுதல் (Post New Announcement)</h3>
                <form action="/add-announcement" method="POST" style="display: flex; flex-direction: column; gap: 15px;">
                    <div class="form-group">
                        <label style="font-weight: bold; margin-bottom: 8px;">அறிவிப்பின் விவரம் (Announcement Content):</label>
                        <textarea name="content" placeholder="பொது மக்களுக்கு தெரிவிக்க வேண்டிய முக்கிய அறிவிப்பை இங்கே எழுதவும்..." required style="padding: 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; min-height: 100px; resize: vertical;"></textarea>
                    </div>
                    <button type="submit" class="btn-submit" style="background-color: #1e3c72; max-width: 200px;">📤 அறிவிப்பை வெளியிடு</button>
                </form>
            </div>

            <div id="deptOverview" class="card toggle-section">
                <h3 style="color:#1e3c72;">📊 துறை வாரியான மனுக்கள் நிலவரம்</h3>
                <table>
                    <thead>
                        <tr><th>துறை பெயர் (Department)</th><th>மொத்த மனுக்கள் எண்ணிக்கை</th></tr>
                    </thead>
                    <tbody>
                        <% 
                            let categories = ["Drinking_Water", "Road_Repair", "Street_Light", "Sewage_Drainage", "Electricity"];
                            categories.forEach(cat => {
                                let count = mlaComplaints.filter(c => c.grievanceCategory === cat).length;
                        %>
                            <tr><td><strong><%= cat %></strong></td><td><span style="font-size:16px; color:#1e3c72; font-weight:bold;"><%= count %></span></td></tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <div id="wardPendingList" class="card toggle-section">
                <h3 style="color:#b71c1c;">📍 வார்டு வாரியான நிலுவை மனுக்கள்</h3>
                <table>
                    <thead>
                        <tr><th>வார்டு எண் (Ward No)</th><th>புதிய மனுக்கள் (Pending)</th><th>நடவடிக்கையில் உள்ளவை (In Progress)</th></tr>
                    </thead>
                    <tbody>
                        <% if (typeof wardList !== 'undefined' && wardList[constituency]) { 
                            wardList[constituency].forEach(ward => {
                                let pending = mlaComplaints.filter(c => c.wardZone === ward && c.status.startsWith('Pending')).length;
                                let progress = mlaComplaints.filter(c => c.wardZone === ward && c.status === 'In_Progress').length;
                        %>
                            <tr>
                                <td><strong><%= ward %></strong></td>
                                <td style="color:orange; font-weight:bold;"><%= pending %></td>
                                <td style="color:blue; font-weight:bold;"><%= progress %></td>
                            </tr>
                        <% })} %>
                    </tbody>
                </table>
            </div>

            <div id="leaderboard-section" class="mla-dynamic-section" style="display: none; background: white; padding: 20px; margin-bottom: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                <h3 style="margin-top:0; color:#333;">🏆 துறை செயல்திறன் லீடர்போர்டு (Leaderboard)</h3>
                <table style="width:100%; border-collapse: collapse; text-align: left; font-size: 14px;">
                    <thead>
                        <tr style="background: #b71c1c; color: white;">
                            <th style="padding: 10px;">துறை (Department)</th>
                            <th style="padding: 10px;">முடித்தவை</th>
                            <th style="padding: 10px;">வெற்றி விகிதம்</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% 
                        let finalLeaderboard = [];
                        if (typeof leaderboard !== 'undefined') {
                            finalLeaderboard = leaderboard;
                        } else if (typeof complaintsList !== 'undefined') {
                            let depts = ['Water', 'Electricity', 'Roads', 'Sanitation'];
                            finalLeaderboard = depts.map(dept => {
                                let total = complaintsList.filter(c => c.department === dept).length;
                                let resolved = complaintsList.filter(c => c.department === dept && c.status === 'Completed').length;
                                let rate = total > 0 ? Math.round((resolved / total) * 100) : 0;
                                return { department: dept, resolvedCount: resolved, successRate: `${rate}%` };
                            });
                            finalLeaderboard.sort((a, b) => b.resolvedCount - a.resolvedCount);
                        }
                        finalLeaderboard.forEach(dept => { 
                        %>
                            <tr style="border-bottom: 1px solid #eee;">
                                <td style="padding: 10px; font-weight: bold;"><%= dept.department %></td>
                                <td style="padding: 10px; color: green; font-weight: bold;"><%= dept.resolvedCount %> மனுக்கள்</td>
                                <td style="padding: 10px;"><span style="background:#e8f5e9; color:#2e7d32; padding:4px 10px; border-radius:12px; font-size:12px; font-weight: bold;"><%= dept.successRate %></span></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

