                                    </div>

                                    <div id="poster-reels-<%= item.grievanceId %>" style="position: absolute; left: -9999px; width: 1080px; height: 1920px; background: linear-gradient(180deg, #00152b 0%, #002244 50%, #003366 100%); color: white; padding: 60px; box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; text-align: center;">
                                        <div>
                                            <h1 style="margin: 0; font-size: 55px; color: var(--gov-gold);">🏛️ தமிழ்நாடு அரசு மக்கள் குறைதீர்ப்பு</h1>
                                            <p style="font-size: 32px; background: rgba(255,255,255,0.1); padding: 15px; border-radius: 6px; margin-top: 15px;">தொகுதி: <%= constituency %> | மனு எண்: <%= item.grievanceId %></p>
                                        </div>
                                        <div style="background: rgba(255,255,255,0.08); padding: 40px; border-radius: 10px; border-left: 15px solid var(--gov-gold); text-align: left;">
                                            <span style="font-size: 45px; font-weight: bold;"><%= item.grievanceCategory %></span>
                                            <p style="font-size: 38px; line-height: 1.6; color: #f1f3f5;"><%= item.description %></p>
