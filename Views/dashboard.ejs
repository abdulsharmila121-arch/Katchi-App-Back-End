                </table>
            </div>
        <% } %>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <script>
        window.onload = function() {
            setInterval(() => {
                document.querySelectorAll('.sla-timer').forEach(timer => {
                    let deadline = parseInt(timer.getAttribute('data-deadline'));
                    if (deadline) {
                        let now = new Date().getTime();
                        let diff = deadline - now;
                        if (diff <= 0) {
                            timer.innerHTML = "🚨 காலக்கெடு முடிந்தது!";
                            timer.style.color = "red";
                        } else {
                            let hours = Math.floor(diff / (1000 * 60 * 60));
                            let minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                            let seconds = Math.floor((diff % (1000 * 60)) / 1000);
                            timer.innerHTML = `⏳ ${hours}ம ${minutes}நி ${seconds}வி`;
                        }
                    }
                });
            }, 1000);
        };

        document.addEventListener("DOMContentLoaded", function() {
            const hasSeen = localStorage.getItem('hasSeenThirukkural');
            const kuralModal = document.getElementById('kuralModal');

            if (kuralModal) {
                if (hasSeen === 'true') {
                    kuralModal.style.display = 'none';
                } else {
                    kuralModal.style.display = 'flex';
                }
            }

            document.querySelectorAll('.dynamic-status-switcher').forEach(select => {
                select.addEventListener('change', function() {
                    const grievanceId = this.getAttribute('data-id');
                    const status = this.value;
                    const loader = document.getElementById(`loader-${grievanceId}`);
                    if(loader) loader.style.display = 'inline';
                    
                    fetch('/update-status-ajax', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ grievanceId, status })
                    })
                    .then(res => res.json())
                    .then(data => {
                        if(loader) loader.style.display = 'none';
                    })
                    .catch(err => {
                        if(loader) loader.style.display = 'none';
                    });
                });
            });
        });

        function closeKuralModal() {
            localStorage.setItem('hasSeenThirukkural', 'true');
            const modal = document.getElementById('kuralModal');
            if (modal) {
                modal.style.transition = 'opacity 0.3s ease';
                modal.style.opacity = '0';
                setTimeout(() => {
                    modal.style.display = 'none';
                }, 300);
            }
        }

        function handleLogout() {
            localStorage.removeItem('hasSeenThirukkural');
        }

        function toggleNotifications() {
            const dropdown = document.getElementById('notificationDropdown');
            if (dropdown) dropdown.classList.toggle('show');
        }

        function requestPushPermission() {
            if ('Notification' in window) {
                Notification.requestPermission().then(permission => {
                    if (permission === 'granted') {
                        alert('✅ Web Push Notifications வெற்றிகரமாக ஆன் செய்யப்பட்டது!');
                    } else {
                        alert('⚠️ நோட்டிபிகேஷன் அனுமதி மறுக்கப்பட்டது.');
                    }
                });
            } else {
                alert('மன்னிக்கவும், உங்கள் உலாவி (Browser) Push Notifications-ஐ ஆதரிக்கவில்லை.');
            }
        }

        function generateDynamicPDF(grievanceId, citizenName, officerRole, category) {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('landscape');

            doc.setDrawColor(0, 51, 102);
            doc.setLineWidth(4);
            doc.rect(10, 10, 277, 190);

            doc.setFont("helvetica", "bold");
            doc.setFontSize(22);
            doc.setTextColor(0, 51, 102);
            doc.text("GOVERNMENT OF TAMIL NADU", 140, 35, { align: "center" });

            doc.setFontSize(16);
            doc.setTextColor(183, 28, 28);
            doc.text("GRIEVANCE REDRESSAL SERVICE CERTIFICATE", 140, 50, { align: "center" });

            doc.setFontSize(12);
            doc.setTextColor(50, 50, 50);
            doc.setFont("helvetica", "normal");
            doc.text("This is to officially certify that the grievance registered under ID:", 140, 75, { align: "center" });

            doc.setFontSize(16);
            doc.setFont("helvetica", "bold");
            doc.text(grievanceId, 140, 90, { align: "center" });

            doc.setFontSize(12);
            doc.setFont("helvetica", "normal");
            doc.text(`Submitted by Citizen: ${citizenName}`, 140, 105, { align: "center" });
            doc.text(`Category: ${category}`, 140, 115, { align: "center" });

            doc.setFont("helvetica", "italic");
            doc.text(`Has been successfully resolved on time by the designated authority (${officerRole}).`, 140, 130, { align: "center" });

            doc.setFont("helvetica", "bold");
            doc.setFontSize(11);
            doc.text("__________________________", 50, 170);
            doc.text("Member of Legislative Assembly (MLA)", 50, 178);

            doc.text("__________________________", 230, 170, { align: "right" });
            doc.text("Chief Minister Special Cell", 230, 178, { align: "right" });

            doc.save(`Certificate_${grievanceId}.pdf`);
        }

        function showMlaSection(sectionId) {
            const el = document.getElementById(sectionId);
            if(el) {
                el.style.display = (el.style.display === 'none' || el.style.display === '') ? 'block' : 'none';
            }
        }

        function downloadPDFReport() {
            const element = document.getElementById('poruppalarWorkTable');
            if(!element) return alert("டேபிள் தரவு இல்லை!");
            const options = {
                margin:       10,
                filename:     'Poruppalar_Work_Report.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2 },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'landscape' }
            };
            html2pdf().from(element).set(options).save();
        }

        function toggleSidebar() {
            const sidebar = document.querySelector('.sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            if(sidebar && overlay) {
                sidebar.classList.toggle('active');
                overlay.classList.toggle('active');
            }
        }

        function toggleSection(sectionId) {
            const section = document.getElementById(sectionId);
            if (section) {
                if (section.style.display === "block") {
                    section.style.display = "none";
                } else {
                    document.querySelectorAll('.toggle-section').forEach(s => s.style.display = 'none');
                    section.style.display = "block";
                }
            }
        }

        function getCurrentLocation() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(position => {
                    document.getElementById('googleMapLocation').value = position.coords.latitude + ", " + position.coords.longitude;
                    alert("📍 உங்கள் தற்போதைய இருப்பிடம் எடுக்கப்பட்டது!");
                });
            }
        }

        function startSpeechToText() {
            const voiceBtn = document.getElementById('voiceBtn');
            const descriptionBox = document.getElementById('description');
            const langSelect = document.getElementById('voiceLangSelect');
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                alert("மன்னிக்கவும், உங்கள் பிரவுசரில் வாய்ஸ் டைப்பிங் வசதி இல்லை!");
                return;
            }
            const recognition = new SpeechRecognition();
            recognition.lang = langSelect.value;
            recognition.interimResults = false;
            voiceBtn.innerHTML = "⏳ பேசலாம்...";
            voiceBtn.style.background = "#2e7d32";
            recognition.start();

            recognition.onresult = function(event) {
                const result = event.results[0][0].transcript;
                descriptionBox.value += result + " ";
                descriptionBox.dispatchEvent(new Event('input')); 
            };
            recognition.onspeechend = function() {
                recognition.stop();
                voiceBtn.innerHTML = "🎙️ வாய்ஸ் டைப்பிங் (AI Voice)";
                voiceBtn.style.background = "#2e7d32";
            };
            recognition.onerror = function() {
                voiceBtn.innerHTML = "🎙️ வாய்ஸ் டைப்பிங் (AI Voice)";
                voiceBtn.style.background = "#2e7d32";
                alert("மீண்டும் முயற்சிக்கவும்!");
            };
        }

        function generatePoster(grievanceId, type) {
            const posterElement = document.getElementById(`poster-${type}-${grievanceId}`);
            if (!posterElement) {
                alert("போஸ்டர் விவரம் கிடைக்கவில்லை!");
                return;
            }
            html2canvas(posterElement, { scale: 2 }).then(canvas => {
                const link = document.createElement('a');
                link.download = `Poster_${type}_${grievanceId}.png`;
                link.href = canvas.toDataURL();
                link.click();
            });
        }

        function autoSelectDepartment() {
            const description = document.getElementById('description').value.toLowerCase();
            const departmentSelect = document.getElementById('department');
            const suggestTag = document.getElementById('aiSuggestTag');

            if (description.includes("சாலை") || description.includes("road")) {
                departmentSelect.value = "சாலை பழுது";
                suggestTag.innerText = "🤖 AI பரிந்துரை: சாலை பழுது தேர்ந்தெடுக்கப்பட்டது";
            } else if (description.includes("தண்ணீர்") || description.includes("குடிநீர்") || description.includes("water")) {
                departmentSelect.value = "குடிநீர் பிரச்சனை";
                suggestTag.innerText = "🤖 AI பரிந்துரை: குடிநீர் பிரச்சனை தேர்ந்தெடுக்கப்பட்டது";
            } else if (description.includes("விளக்கு") || description.includes("light")) {
                departmentSelect.value = "தெரு விளக்கு பிரச்சனை";
                suggestTag.innerText = "🤖 AI பரிந்துரை: தெரு விளக்கு பிரச்சனை தேர்ந்தெடுக்கப்பட்டது";
            } else if (description.includes("சாக்கடை") || description.includes("கழிவுநீர்") || description.includes("drain")) {
                departmentSelect.value = "கழிவுநீர் / கால்வாய் பிரச்சனை";
                suggestTag.innerText = "🤖 AI பரிந்துரை: கழிவுநீர் பிரச்சனை தேர்ந்தெடுக்கப்பட்டது";
            } else if (description.includes("மின்சாரம்") || description.includes("current") || description.includes("power")) {
                departmentSelect.value = "மின்சார பிரச்சனை";
                suggestTag.innerText = "🤖 AI பரிந்துரை: மின்சார பிரச்சனை தேர்ந்தெடுக்கப்பட்டது";
            } else {
                suggestTag.innerText = "";
            }
        }
    </script>
    <script>
        const dataHolder = document.getElementById('districtDataHolder');
        const districtDataList = dataHolder ? JSON.parse(dataHolder.getAttribute('data-districts') || '[]') : [];

        function loadConstituencies() {
            const districtSelect = document.getElementById('districtSelect');
            const constituencySelect = document.getElementById('constituencySelect');
            const selectedDistrict = districtSelect.value;

            constituencySelect.innerHTML = '<option value="">-- தொகுதியை தேர்வு செய்யவும் --</option>';

            if (selectedDistrict && Array.isArray(districtDataList)) {
                const found = districtDataList.find(d => d.district === selectedDistrict);
                if (found && found.constituencies) {
                    found.constituencies.forEach(function(constituency) {
                        const opt = document.createElement('option');
                        opt.value = constituency;
                        opt.textContent = constituency;
                        constituencySelect.appendChild(opt);
                    });
                }
            }
        }
    </script>
    <!-- JS Script -->
    <script>
        function updateFileName(input, targetId) {
            const displaySpan = document.getElementById(targetId);
            if (input.files && input.files.length > 0) {
                displaySpan.textContent = "✔ " + input.files[0].name;
            } else {
                displaySpan.textContent = "";
            }
        }
    </script>
