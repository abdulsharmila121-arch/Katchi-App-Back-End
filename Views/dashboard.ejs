<% if ((typeof user !== 'undefined' && user && user.role === 'Poruppalar') || (typeof currentRole !== 'undefined' && currentRole === 'Poruppalar' && typeof complaints !== 'undefined')) { 
    let poruppalarComplaints = complaints.filter(c => c.constituency === constituency);
%>
