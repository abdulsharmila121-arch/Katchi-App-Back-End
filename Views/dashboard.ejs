        <input type="hidden" name="grievanceId" value="<%= item.grievanceId %>">
        <input type="hidden" name="citizenName" value="<%= item.citizenName %>">
        <input type="hidden" name="district" value="<%= item.district %>">
        <input type="hidden" name="description" value="<%= item.description %>">
        
        <button type="submit" class="status-btn" style="background-color: #0d6efd; color: white; padding: 6px 12px; border-radius: 4px; border: none; cursor: pointer; font-weight: bold;">
            ⏩ Forward to Collector
        </button>
    </form>

    <!-- Option 2: CM Collector-க்கு அனுப்பும் Letter-ஐ PDF-ஆக Download செய்யும் Action -->
    <form action="/cm/forward-to-collector-pdf" method="POST">
    <input type="hidden" name="grievanceId" value="<%= complaint.grievanceId %>">
    <input type="hidden" name="citizenName" value="<%= complaint.citizenName %>">
    <input type="hidden" name="district" value="<%= complaint.district %>">
    <input type="hidden" name="description" value="<%= complaint.description %>">
    <button type="submit" class="btn btn-primary">PDF பதிவிறக்கம்</button>
</form>

</td>
