                                                    <img src="/uploads/<%= item.beforeImage %>" style="width:38px; height:38px; object-fit:cover; border-radius:3px;"><br>
                                                    <small style="font-size:9.5px; color:#555;">Before</small>
                                                </div>
                                                <div style="text-align:center;">
                                                    <img src="/uploads/<%= item.afterImage %>" style="width:38px; height:38px; object-fit:cover; border-radius:3px;"><br>
                                                    <small style="font-size:9.5px; color:#555;">After</small>
                                                </div>
                                            </div>
                                            <span style="color:#2e7d32; font-weight:bold; font-size:11.5px; display:block; margin-top:4px;">✓ பணி முழுமையாக முடிந்தது</span>
                                            
                                            <% if(item.fieldNotes) { %>
                                                <div style="font-size: 10.5px; color: #333; background: #f1f5f9; padding: 4px; border-radius: 3px; margin-top: 4px;">
                                                    <strong>கள அறிக்கை:</strong> <%= item.fieldNotes %>
                                                </div>
                                            <% } %>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div style="margin-bottom: 8px;">
                                            <label style="font-size:11px; font-weight:bold;">Live Status:</label><br>
                                            <select class="status-select dynamic-status-switcher" data-id="<%= item.grievanceId %>" style="padding:4px; font-size:11px; font-weight:bold;">
                                                <option value="Pending_Managaram" <%= item.status === 'Pending_Managaram' ? 'selected' : '' %>>Pending</option>
                                                <option value="In_Progress" <%= item.status === 'In_Progress' ? 'selected' : '' %>>In Progress</option>
                                                <option value="Completed" <%= item.status === 'Completed' ? 'selected' : '' %>>Completed</option>
                                            </select>
                                            <span class="ajax-loader" id="loader-<%= item.grievanceId %>" style="font-size:10.5px; color:#2e7d32; display:none; margin-left:4px;">🔄 Saving...</span>
                                        </div>

                                        <div style="display: flex; flex-direction: column; gap: 5px; margin-top: 4px;">
                                            <% 
                                                let whatsappNumber = item.citizenMobile ? item.citizenMobile.replace('+', '') : '';
                                                let rawMsg = `வணக்கம் ${item.citizenName}, உங்களது மனு எண்: ${item.grievanceId} பற்றிய கள நிலவரம் தொடர்பாக உங்களைத் தொடர்பு கொள்கிறேன்.`;
                                                let encodedMsg = encodeURIComponent(rawMsg);
                                            %>
                                            <a href="https://api.whatsapp.com/send?phone=<%= whatsappNumber %>&text=<%= encodedMsg %>" target="_blank" style="background-color: #25D366; color: white; border: none; padding: 5px 10px; font-size: 11.5px; font-weight: bold; border-radius: 3px; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 4px;">
                                                WhatsApp
                                            </a>

                                            <% if (item.googleMapLocation && item.googleMapLocation !== 'Coordinates' && item.googleMapLocation !== '') { %>
                                                <a href="https://www.google.com/maps/dir/?api=1&destination=<%= encodeURIComponent(item.googleMapLocation) %>" 
                                                   target="_blank" 
                                                   class="btn-map-route">
                                                   📍 Go to Location
                                                </a>
                                            <% } else { %>
                                                <span class="no-location">❌ No GPS Data</span>
                                            <% } %>

                                            <% if (item.citizenMobile) { %>
                                                <a href="tel:<%= item.citizenMobile %>" class="btn-direct-call">
                                                    📞 Call Citizen
                                                </a>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        <% } %>

